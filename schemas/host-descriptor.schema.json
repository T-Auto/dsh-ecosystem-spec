{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dsh.community/schemas/host-descriptor-0.1.json",
  "title":"DSH Host Descriptor v0.1",
  "type":"object","additionalProperties":false,
  "required":["$schema","hostId","hostVersion","apiVersions","contracts","runtime","trustLevel","platform"],
  "properties":{
    "$schema":{"type":"string","const":"https://dsh.community/schemas/host-descriptor-0.1.json"},
    "hostId":{"type":"string","pattern":"^[a-z0-9]+([.-][a-z0-9]+)*$"},
    "hostVersion":{"type":"string","minLength":1},
    "apiVersions":{"type":"array","items":{"type":"string","pattern":"^0\\.1(?:\\.x)?$"},"minItems":1,"uniqueItems":true},
    "contracts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","version","schemaHash","permissions"],"properties":{"name":{"type":"string"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"},"schemaHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"permissions":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},"uniqueItems":true},
    "runtime":{"type":"object","additionalProperties":false,"required":["location","generationId","headless"],"properties":{"location":{"enum":["local","remote","container"]},"generationId":{"type":"string","pattern":"^[A-Za-z0-9._:-]+$"},"headless":{"type":"boolean"},"remoteAttach":{"type":"boolean"}}},
    "trustLevel":{"enum":["trusted-in-process"]},
    "platform":{"type":"object","additionalProperties":false,"required":["os","arch"],"properties":{"os":{"type":"string"},"arch":{"type":"string"},"node":{"type":"string"}}}
  }
}
