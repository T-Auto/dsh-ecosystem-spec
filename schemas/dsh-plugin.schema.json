{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.community/schemas/dsh-plugin-0.1.json",
  "title": "DSH Plugin Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "name", "version", "manifestVersion", "apiVersion", "entry", "requires", "permissions", "contributes", "subscriptions", "license", "source"],
  "properties": {
    "$schema": {"type":"string","const":"https://dsh.community/schemas/dsh-plugin-0.1.json"},
    "id": {"type":"string","pattern":"^[a-z0-9]+([.-][a-z0-9]+)*$","minLength":3,"maxLength":128},
    "name": {"type":"string","minLength":1,"maxLength":128},
    "version": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "manifestVersion": {"type":"string","const":"0.1"},
    "apiVersion": {"type":"string","pattern":"^0\\.1(?:\\.x)?$"},
    "entry": {"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"},
    "requires": {"$ref":"#/$defs/requirements"},
    "permissions": {"type":"array","items":{"$ref":"#/$defs/permission"},"uniqueItems":true},
    "contributes": {"$ref":"#/$defs/contributes"},
    "subscriptions": {"type":"array","items":{"$ref":"#/$defs/subscription"},"uniqueItems":true},
    "license": {"type":"string","minLength":1,"maxLength":128},
    "source": {"type":"object","additionalProperties":false,"required":["repository"],"properties":{"repository":{"type":"string","format":"uri"},"revision":{"type":"string","minLength":1}}},
    "artifact": {"$ref":"#/$defs/artifact"},
    "compat": {"type":"object","additionalProperties":false,"properties":{"hosts":{"type":"array","items":{"type":"string"}}}},
    "overrides": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["target","kind"],"properties":{"target":{"type":"string"},"kind":{"enum":["patch","native","build"]},"description":{"type":"string"}}}}
  },
  "$defs": {
    "contractRef": {"type":"object","additionalProperties":false,"required":["name","version","schemaHash"],"properties":{"name":{"type":"string","pattern":"^(storage\\.local|commands|messages\\.observe|x-[a-z0-9.-]+\\..+)$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"},"schemaHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"fallback":{"type":"string","minLength":1}}},
    "optionalContractRef": {"type":"object","additionalProperties":false,"required":["name","version","schemaHash","fallback"],"properties":{"name":{"type":"string","pattern":"^(storage\\.local|commands|messages\\.observe|x-[a-z0-9.-]+\\..+)$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"},"schemaHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"fallback":{"type":"string","minLength":1}}},
    "requirements": {"type":"object","additionalProperties":false,"required":["capabilities"],"properties":{"capabilities":{"type":"object","additionalProperties":false,"required":["required","optional"],"properties":{"required":{"type":"array","items":{"$ref":"#/$defs/contractRef"},"uniqueItems":true},"optional":{"type":"array","items":{"$ref":"#/$defs/optionalContractRef"},"uniqueItems":true}}},"services":{"type":"array","maxItems":0}}},
    "permission": {"type":"object","additionalProperties":false,"required":["name","scope"],"properties":{"name":{"type":"string","enum":["messages.observe.read","storage.local.read","storage.local.write","commands.invoke"]},"scope":{"type":"string","minLength":1,"maxLength":256},"reason":{"type":"string","minLength":1,"maxLength":512}}},
    "contributes": {"type":"object","additionalProperties":false,"required":["commands"],"properties":{"commands":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","title"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9]+([.-][a-z0-9]+)*\\.[a-z0-9]+([.-][a-z0-9]+)*$"},"title":{"type":"string","minLength":1,"maxLength":128},"description":{"type":"string","maxLength":512}}},"uniqueItems":true},"panels":{"type":"array","maxItems":0}}},
    "subscription": {"type":"object","additionalProperties":false,"required":["event","version","schemaHash"],"properties":{"event":{"const":"messages.observe"},"version":{"type":"string","const":"0.1"},"schemaHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"scope":{"type":"string","minLength":1,"maxLength":256}}},
    "artifact": {"type":"object","additionalProperties":false,"required":["digest","algorithm","path"],"properties":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"algorithm":{"const":"sha256"},"path":{"type":"string","minLength":1}}}
  }
}
