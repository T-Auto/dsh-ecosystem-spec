{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dsh.community/schemas/messages-observe-envelope-0.1.json",
  "title":"messages.observe envelope v0.1",
  "type":"object","additionalProperties":false,
  "required":["eventType","eventVersion","eventId","scope","sequence","privacyClass","summary","payload"],
  "properties":{
    "eventType":{"const":"messages.observe"},
    "eventVersion":{"const":"0.1"},
    "eventId":{"type":"string","pattern":"^[A-Za-z0-9._:-]+$"},
    "scope":{"type":"string","minLength":1,"maxLength":256},
    "sequence":{"type":"integer","minimum":0},
    "privacyClass":{"enum":["public","internal","sensitive"]},
    "summary":{"type":"string","maxLength":1024},
    "payload":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string","enum":["message.created","message.received","message.sent"]},"messageId":{"type":"string","maxLength":256},"author":{"type":"string","maxLength":256},"textPreview":{"type":"string","maxLength":1024}}}
  }
}
